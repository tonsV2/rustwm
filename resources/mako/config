# rustwm's notifications. Colours match the Alt+Tab switcher and the panel.
# Copy this file to ~/.config/rustwm/mako/config to change it; see mako(5).

font=sans 10
background-color=#1f1f21f0
text-color=#f2f2f2
border-size=1
border-color=#ffffff1f
border-radius=12
padding=12
margin=10
width=360
max-icon-size=48
icon-location=left
anchor=bottom-right
# Above windows, in the bottom-right corner, which is out of the way of the panel at the top.
layer=top
# Apps that set no timeout of their own: hide after 10 seconds, long enough to reach for the mouse and click.
default-timeout=10000
max-visible=3
# A click runs the notification's action (usually opens it); a right click dismisses it.
on-button-left=invoke-default-action
on-button-right=dismiss

[urgency=low]
text-color=#f2f2f2bf

[urgency=critical]
background-color=#6e2a35f0
default-timeout=0

# `makoctl mode -t do-not-disturb` toggles hiding notifications.
[mode=do-not-disturb]
invisible=1
