#!/usr/bin/env python3
"""Relays the Secret Service from the shared user bus to rustwm's private bus.

rustwm runs on a D-Bus bus of its own when another graphical session of the
same user runs alongside (see rustwm-session). The GNOME keyring daemon that
PAM unlocked at login only answers on the shared bus, and a second daemon on
the private bus would start with the keyring locked. This relay owns
org.freedesktop.secrets on the private bus and passes every call to the
daemon on the shared bus, so apps see the already unlocked keyring.

Usage: rustwm-secrets-relay SHARED_BUS_ADDRESS
The private bus is the one in DBUS_SESSION_BUS_ADDRESS. The relay exits when
either bus goes away.
"""

import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NAME = "org.freedesktop.secrets"


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())

    loop = GLib.MainLoop()
    private = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    shared = Gio.DBusConnection.new_for_address_sync(
        sys.argv[1],
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
        None,
        None,
    )
    for bus in (private, shared):
        bus.set_exit_on_close(False)
        bus.connect("closed", lambda *_: loop.quit())

    def reply(call, result):
        try:
            answer = shared.send_message_with_reply_finish(result)
        except GLib.Error as err:
            out = call.new_method_error_literal("org.freedesktop.DBus.Error.Failed", err.message)
        else:
            if answer.get_message_type() == Gio.DBusMessageType.ERROR:
                body = answer.get_body()
                text = body.unpack()[0] if body is not None and body.n_children() else ""
                out = call.new_method_error_literal(answer.get_error_name(), text)
            else:
                out = call.new_method_reply()
                if answer.get_body() is not None:
                    out.set_body(answer.get_body())
        private.send_message(out, Gio.DBusSendMessageFlags.NONE)

    def forward(call):
        copy = call.copy()
        copy.set_destination(NAME)
        # Secret Service prompts are asynchronous, so no call should wait
        # long; the timeout only guards against a hung daemon.
        shared.send_message_with_reply(
            copy, Gio.DBusSendMessageFlags.NONE, 120_000, None, lambda _, res: reply(call, res)
        )
        return GLib.SOURCE_REMOVE

    unique = private.get_unique_name()

    def incoming(_, message, is_incoming):
        # Filters run on GDBus's worker thread; the forwarding happens on the
        # main loop.
        if (
            is_incoming
            and message.get_message_type() == Gio.DBusMessageType.METHOD_CALL
            and message.get_destination() in (NAME, unique)
        ):
            GLib.idle_add(forward, message)
            return None
        return message

    private.add_filter(incoming)

    # Signals such as a prompt's Completed and item change notifications.
    shared.signal_subscribe(
        NAME,
        None,
        None,
        None,
        None,
        Gio.DBusSignalFlags.NONE,
        lambda _, _sender, path, iface, member, params: private.emit_signal(
            None, path, iface, member, params
        ),
    )

    Gio.bus_own_name_on_connection(
        private, NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE, None, lambda *_: loop.quit()
    )
    loop.run()


if __name__ == "__main__":
    main()
