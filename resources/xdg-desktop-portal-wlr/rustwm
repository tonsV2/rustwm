# xdg-desktop-portal-wlr settings for XDG_CURRENT_DESKTOP=rustwm. Installed
# as /etc/xdg/xdg-desktop-portal-wlr/rustwm; a copy in
# ~/.config/xdg-desktop-portal-wlr/rustwm replaces it for one user.
[screencast]
# Ask what to share, the monitor or one window, with a Fuzzel menu. Without
# this the portal runs slurp, which only picks monitors. chooser_type=none
# shares the whole screen without asking.
chooser_type=dmenu
chooser_cmd=fuzzel --dmenu --prompt "Share: "
