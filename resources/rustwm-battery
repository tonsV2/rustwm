#!/usr/bin/env bash
# Warns through the notification daemon before the battery runs out. The
# panel's battery module only changes colour, and with the panel hidden
# nobody sees it.
#
# Usage: rustwm-battery [PERCENT...]   (default: 20 10 5)
#
# It follows UPower's display device (the battery as a whole) over D-Bus and,
# while discharging, sends a notification the first time the charge falls to
# each percentage, replacing the previous one. The lowest is critical, so it
# stays until dismissed. Plugging the charger in closes the notification and
# starts over. It exits once nothing listens on rustwm's Wayland socket any
# more, since it is not a Wayland client and would not notice otherwise. The
# socket file alone does not tell: a compositor killed by a signal leaves it
# behind.
set -euo pipefail

if (($# == 0)); then
    set -- 20 10 5
fi
for level in "$@"; do
    if ! [[ "$level" =~ ^[0-9]+$ ]] || ((level > 100)); then
        echo "usage: rustwm-battery [PERCENT...]" >&2
        exit 2
    fi
done
mapfile -t levels < <(printf '%s\n' "$@" | sort -rnu)
lowest=${levels[-1]}

for tool in busctl gdbus ss; do
    if ! command -v "$tool" >/dev/null; then
        echo "rustwm-battery: $tool is missing" >&2
        exit 1
    fi
done

upower=org.freedesktop.UPower
device=/org/freedesktop/UPower/devices/DisplayDevice
notifications=org.freedesktop.Notifications

# busctl prints each property as "<type> <value>", such as "d 37.5" or "u 2".
property() {
    busctl --system get-property "$upower" "$device" "$upower.Device" "$@" | cut -d' ' -f2-
}

# Type 2 is a battery; desktops report 0 for the display device.
if [[ "$(property Type)" != 2 ]]; then
    echo "rustwm-battery: no battery, nothing to watch" >&2
    exit 0
fi

socket=${WAYLAND_DISPLAY:-}
if [[ -n "$socket" && "$socket" != /* ]]; then
    socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$socket"
fi

# The notification daemon starts just before this script.
gdbus wait --session --timeout 20 "$notifications" || true

notify() {
    local id=$1 urgency=$2 icon=$3 summary=$4 body=$5
    gdbus call --session --dest "$notifications" --object-path /org/freedesktop/Notifications \
        --method "$notifications.Notify" -- rustwm "$id" "$icon" "$summary" "$body" '[]' \
        "{'urgency': <byte $urgency>}" -1 | sed 's/.*uint32 \([0-9]*\).*/\1/'
}

close() {
    gdbus call --session --dest "$notifications" --object-path /org/freedesktop/Notifications \
        --method "$notifications.CloseNotification" "$1" >/dev/null
}

time_left() {
    local seconds=$1 hours minutes
    ((seconds > 0)) || return 0
    hours=$((seconds / 3600))
    minutes=$((seconds % 3600 / 60))
    if ((hours > 0)); then
        printf ', about %d h %d min left' "$hours" "$minutes"
    else
        printf ', about %d min left' "$minutes"
    fi
}

warned=""
id=0
check() {
    local percentage state seconds level urgency icon summary body
    { read -r percentage; read -r state; read -r seconds; } < <(property Percentage State TimeToEmpty) || true
    # A failed read (UPower restarting, say) is left for the next wake-up.
    [[ -n "$seconds" ]] || return 0
    percentage=${percentage%%.*}
    # State 2 is discharging. Anything else means the charger is in, or
    # UPower does not know yet, and neither deserves a warning.
    if [[ "$state" != 2 ]]; then
        if ((id > 0)); then
            close "$id" || true
            id=0
        fi
        warned=""
        return
    fi
    level=""
    for candidate in "${levels[@]}"; do
        ((percentage <= candidate)) && level=$candidate
    done
    [[ -n "$level" ]] || return 0
    [[ -z "$warned" || "$level" -lt "$warned" ]] || return 0
    warned=$level
    if ((level == lowest)); then
        urgency=2
        icon=battery-caution
        summary="Battery almost empty"
    else
        urgency=1
        icon=battery-low
        summary="Battery low"
    fi
    body="${percentage}%$(time_left "$seconds")"
    id=$(notify "$id" "$urgency" "$icon" "$summary" "$body") || {
        echo "rustwm-battery: could not send the notification" >&2
        id=0
    }
}

compositor_listens() {
    [[ -n "$socket" ]] || return 0
    ss -xlH | awk -v socket="$socket" '$5 == socket { found = 1 } END { exit !found }'
}

# Every property change on the display device wakes the loop, which re-reads
# the properties rather than parsing the signal. The timeout keeps checking
# that rustwm is still there.
exec 3< <(exec gdbus monitor --system --dest "$upower" --object-path "$device" 2>/dev/null)
monitor=$!
trap 'kill "$monitor" 2>/dev/null' EXIT

check
while true; do
    if read -r -t 30 -u 3 _; then
        check
    elif (($? < 128)); then
        echo "rustwm-battery: lost the connection to UPower" >&2
        exit 1
    fi
    compositor_listens || exit 0
done
