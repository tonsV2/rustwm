#!/usr/bin/env python3
"""Relays a D-Bus service from the shared user bus to rustwm's private bus.

rustwm runs on a D-Bus bus of its own when another graphical session of the
same user runs alongside (see rustwm-session). Some services must not get a
second copy on that bus, so this relay owns NAME on the private bus and
passes every call to the copy on the shared bus:

- org.freedesktop.secrets: the GNOME keyring daemon that PAM unlocked at
  login only answers on the shared bus, and a second daemon on the private
  bus would start with the keyring locked. rustwm-session starts this relay.
- org.freedesktop.portal.Documents: the document portal mounts its file
  system at $XDG_RUNTIME_DIR/doc, the path Flatpak sandboxes and the paths
  the portal hands out are built on. A second portal there shares the shared
  portal's mount and unmounts it when it exits, after which no Flatpak app
  starts. D-Bus starts this relay in its place (see dbus/services/).

Usage: rustwm-bus-relay NAME
The private bus is the one in DBUS_SESSION_BUS_ADDRESS, the shared one the
one in RUSTWM_SHARED_BUS_ADDRESS. The relay exits when either bus goes away.
"""

import os
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

# The document portal tells apps apart by the process that calls it, and the
# shared portal only sees the relay, an unsandboxed process. Passing on calls
# from sandboxed apps would give them the rights of an unsandboxed one, so the
# relay refuses them. xdg-desktop-portal, which passes on files the user
# picked in a file chooser, is unsandboxed.
HOST_ONLY = {"org.freedesktop.portal.Documents"}


def main():
    if len(sys.argv) != 2 or "RUSTWM_SHARED_BUS_ADDRESS" not in os.environ:
        sys.exit(__doc__.strip())
    name = sys.argv[1]

    loop = GLib.MainLoop()
    private = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    shared = Gio.DBusConnection.new_for_address_sync(
        os.environ["RUSTWM_SHARED_BUS_ADDRESS"],
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
        None,
        None,
    )
    for bus in (private, shared):
        bus.set_exit_on_close(False)
        bus.connect("closed", lambda *_: loop.quit())

    def reply(call, result):
        try:
            answer = shared.send_message_with_reply_finish(result)
        except GLib.Error as err:
            out = call.new_method_error_literal("org.freedesktop.DBus.Error.Failed", err.message)
        else:
            if answer.get_message_type() == Gio.DBusMessageType.ERROR:
                body = answer.get_body()
                text = body.unpack()[0] if body is not None and body.n_children() else ""
                out = call.new_method_error_literal(answer.get_error_name(), text)
            else:
                out = call.new_method_reply()
                if answer.get_body() is not None:
                    out.set_body(answer.get_body())
        private.send_message(out, Gio.DBusSendMessageFlags.NONE)

    def forward(call):
        if name in HOST_ONLY and is_sandboxed(private, call.get_sender()):
            out = call.new_method_error_literal(
                "org.freedesktop.DBus.Error.AccessDenied",
                f"rustwm-bus-relay does not pass on {name} calls from sandboxed apps",
            )
            private.send_message(out, Gio.DBusSendMessageFlags.NONE)
            return GLib.SOURCE_REMOVE
        # The copy keeps the call's file descriptors, which the document
        # portal needs for the files it is handed.
        copy = call.copy()
        copy.set_destination(name)
        # Secret Service prompts are asynchronous, so no call should wait
        # long; the timeout only guards against a hung daemon.
        shared.send_message_with_reply(
            copy, Gio.DBusSendMessageFlags.NONE, 120_000, None, lambda _, res: reply(call, res)
        )
        return GLib.SOURCE_REMOVE

    unique = private.get_unique_name()

    def incoming(_, message, is_incoming):
        # Filters run on GDBus's worker thread; the forwarding happens on the
        # main loop.
        if (
            is_incoming
            and message.get_message_type() == Gio.DBusMessageType.METHOD_CALL
            and message.get_destination() in (name, unique)
        ):
            GLib.idle_add(forward, message)
            return None
        return message

    private.add_filter(incoming)

    # Signals such as a prompt's Completed and item change notifications.
    shared.signal_subscribe(
        name,
        None,
        None,
        None,
        None,
        Gio.DBusSignalFlags.NONE,
        lambda _, _sender, path, iface, member, params: private.emit_signal(
            None, path, iface, member, params
        ),
    )

    Gio.bus_own_name_on_connection(
        private, name, Gio.BusNameOwnerFlags.DO_NOT_QUEUE, None, lambda *_: loop.quit()
    )
    loop.run()


def is_sandboxed(bus, sender):
    """Whether the process behind `sender` runs in a sandbox.

    A sandboxed process, and the D-Bus proxy Flatpak apps talk to the bus
    through, sees a root folder of its own. When the process cannot be
    looked at, the caller counts as sandboxed.
    """
    try:
        (pid,) = bus.call_sync(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "GetConnectionUnixProcessID",
            GLib.Variant("(s)", (sender,)),
            GLib.VariantType("(u)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
        ).unpack()
        theirs = os.stat(f"/proc/{pid}/root/")
    except (GLib.Error, OSError):
        return True
    ours = os.stat("/")
    return (theirs.st_dev, theirs.st_ino) != (ours.st_dev, ours.st_ino)


if __name__ == "__main__":
    main()
