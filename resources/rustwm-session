#!/usr/bin/env bash
# Starts rustwm on the right D-Bus session bus. start.sh, scripts/nested.sh
# and the GDM session file all go through this script.
#
# Usage: rustwm-session [command...]   (default command: rustwm)
#
# As the user's only graphical session, rustwm uses the shared user bus: the
# keyring PAM unlocked at login is there, and the compositor points the D-Bus
# and systemd activation environment at its Wayland socket.
#
# Next to another graphical session (GNOME on another VT, or nested inside
# it), rustwm gets a private bus instead. Single-instance apps (GTK apps,
# Ghostty) would otherwise hand their windows to copies running there. The
# keyring stays on the shared bus, so rustwm-secrets-relay passes
# org.freedesktop.secrets calls through to it.
set -euo pipefail

if (($# == 0)); then
    set -- rustwm
fi

# True when this user has a graphical session other than the current one.
other_graphical_session() {
    local user id type state
    user=$(id -un)
    for id in $(loginctl show-user "$user" --property=Sessions --value 2>/dev/null); do
        [[ "$id" == "${XDG_SESSION_ID:-}" ]] && continue
        type=$(loginctl show-session "$id" --property=Type --value)
        state=$(loginctl show-session "$id" --property=State --value)
        if [[ ("$type" == wayland || "$type" == x11) && "$state" != closing ]]; then
            return 0
        fi
    done
    return 1
}

shared_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
shared_bus="unix:path=$shared_socket"
nested=false
if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    nested=true
fi

if [[ "$nested" == false && -S "$shared_socket" ]] && ! other_graphical_session; then
    export DBUS_SESSION_BUS_ADDRESS="$shared_bus"
    export RUSTWM_SHARED_BUS=1
    exec "$@"
fi

relay="$(dirname "$(readlink -f "$0")")/rustwm-secrets-relay"
# Inside the private bus: start the relay, then replace the shell with rustwm.
# The relay exits on its own when the bus goes away with rustwm.
# shellcheck disable=SC2016
exec dbus-run-session -- bash -c '"$1" "$2" & shift 2; exec "$@"' _ "$relay" "$shared_bus" "$@"
