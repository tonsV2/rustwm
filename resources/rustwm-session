#!/usr/bin/env bash
# Starts rustwm on the right D-Bus session bus. start.sh, scripts/nested.sh
# and the GDM session file all go through this script.
#
# Usage: rustwm-session [command...]   (default command: rustwm)
#
# As the user's only graphical session, rustwm uses the shared user bus: the
# keyring PAM unlocked at login is there, and the compositor points the D-Bus
# and systemd activation environment at its Wayland socket.
#
# Next to another graphical session (GNOME on another VT, or nested inside
# it), rustwm gets a private bus instead. Single-instance apps (GTK apps,
# Ghostty) would otherwise hand their windows to copies running there. The
# keyring and the document portal stay on the shared bus, and
# rustwm-bus-relay passes calls to them through.
set -euo pipefail

if (($# == 0)); then
    set -- rustwm
fi

# Helper scripts such as rustwm-volume sit next to this one, in the checkout's
# resources/ or in /usr/local/bin once installed.
here="$(dirname "$(readlink -f "$0")")"
export PATH="$here:$PATH"

# True when this user has a graphical session other than the current one.
other_graphical_session() {
    local user id type state
    user=$(id -un)
    for id in $(loginctl show-user "$user" --property=Sessions --value 2>/dev/null); do
        [[ "$id" == "${XDG_SESSION_ID:-}" ]] && continue
        type=$(loginctl show-session "$id" --property=Type --value)
        state=$(loginctl show-session "$id" --property=State --value)
        if [[ ("$type" == wayland || "$type" == x11) && "$state" != closing ]]; then
            return 0
        fi
    done
    return 1
}

shared_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
shared_bus="unix:path=$shared_socket"
nested=false
if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]; then
    nested=true
fi

if [[ "$nested" == false && -S "$shared_socket" ]] && ! other_graphical_session; then
    export DBUS_SESSION_BUS_ADDRESS="$shared_bus"
    export RUSTWM_SHARED_BUS=1
    exec "$@"
fi

# The private bus starts rustwm-bus-relay in place of a second keyring daemon
# and document portal, through a bus config that sits in the checkout's
# resources/ or, installed, under share/, and builds on the system's standard
# session bus config. Without it a second document portal would start, and
# when it exits Flatpak apps stop starting in the other session too, so
# rustwm does not start.
bus_config=""
for dir in "$here/dbus" "$here/../share/rustwm/dbus"; do
    if [[ -f "$dir/session.conf" ]]; then
        bus_config="$dir/session.conf"
        break
    fi
done
services="$(dirname "$bus_config")/services"
if [[ -z "$bus_config" || ! -f /usr/share/dbus-1/session.conf ||
    ! -f "$services/org.freedesktop.portal.Documents.service" ||
    ! -f "$services/org.freedesktop.secrets.service" ]]; then
    echo "rustwm-session: rustwm's D-Bus config (dbus/ next to this script or in" \
        "share/rustwm/) or the system's /usr/share/dbus-1/session.conf is missing" >&2
    exit 1
fi

# D-Bus passes its environment on to the relays it starts.
export RUSTWM_SHARED_BUS_ADDRESS="$shared_bus"
exec dbus-run-session --config-file="$bus_config" -- "$@"
