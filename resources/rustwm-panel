#!/usr/bin/env bash
# Starts Waybar as rustwm's panel. rustwm runs this with RUSTWM_PANEL_POSITION (top or bottom) and RUSTWM_PANEL_MODE (auto-hide or always) from [panel] in config.toml. The config comes from ~/.config/rustwm/waybar if it exists, else from the one shipped with rustwm.
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"
position=${RUSTWM_PANEL_POSITION:-top}
mode=${RUSTWM_PANEL_MODE:-auto-hide}

for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/rustwm/waybar" "$here/waybar" "$here/../share/rustwm/waybar"; do
    if [[ -r "$dir/config.jsonc" ]]; then
        break
    fi
done
[[ -r "$dir/config.jsonc" ]] || { echo "rustwm-panel: no waybar config found" >&2; exit 1; }

# Windows are laid out beside the panel whenever it is on screen. Auto-hide puts it on the overlay layer, above everything, for the moments it shows.
exclusive=true
if [[ "$mode" == always ]]; then
    layer=top
else
    layer=overlay
fi

runtime="${XDG_RUNTIME_DIR:-/tmp}/rustwm"
mkdir -p "$runtime"
sed -e "s/@POSITION@/$position/" -e "s/@LAYER@/$layer/" -e "s/@EXCLUSIVE@/$exclusive/" \
    "$dir/config.jsonc" >"$runtime/waybar.jsonc"
exec waybar -c "$runtime/waybar.jsonc" -s "$dir/style.css"
