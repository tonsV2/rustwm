#!/usr/bin/env bash
# Asks what to share, for xdg-desktop-portal-wlr's dmenu chooser. The portal
# writes one line per monitor ("Monitor: WL-1 Maker Model") and window
# ("Window: Title (identifier)") and reads the chosen line back; no output
# declines. The lines are shown as "Entire screen" and plain window titles in
# a Fuzzel menu with the colours of the Alt+Tab switcher and notifications.
set -euo pipefail

mapfile -t choices
[[ ${#choices[@]} -gt 0 ]] || exit 0

# fuzzel drops lines it cannot decode, and without a UTF-8 locale that is
# every title with an accent or a dash such as "—".
export LC_CTYPE=C.UTF-8

monitors=0
for choice in "${choices[@]}"; do
    [[ $choice == "Monitor: "* ]] && monitors=$((monitors + 1))
done

labels=()
declare -A seen=()
for choice in "${choices[@]}"; do
    case $choice in
    "Monitor: "*)
        # With one monitor its name says nothing.
        if [[ $monitors -eq 1 ]]; then
            label="Entire screen"
        else
            label="Screen: ${choice#Monitor: }"
        fi
        ;;
    "Window: "*)
        # The identifier in brackets is random and means nothing to people.
        label=${choice#Window: }
        label=${label% (*)}
        label=${label:-Untitled window}
        ;;
    *) label=$choice ;;
    esac
    # A tab would start a new column in the menu below.
    label=${label//$'\t'/ }
    # Windows with the same title, such as two terminals, get a number.
    seen[$label]=$((${seen[$label]:-0} + 1))
    if [[ ${seen[$label]} -gt 1 ]]; then
        label="$label (${seen[$label]})"
    fi
    labels+=("$label")
done

# Each line is "<number><tab><label>": fuzzel shows the label and prints the
# number, so a line fuzzel skips cannot shift which window is shared.
# --only-match keeps Enter on a filter that matches nothing from returning
# the typed text. Escape or a click outside makes fuzzel fail: nothing is
# shared.
index=$(for i in "${!labels[@]}"; do printf '%s\t%s\n' "$i" "${labels[i]}"; done |
    fuzzel --dmenu --only-match --with-nth 2 --accept-nth 1 \
        --prompt "Share: " --placeholder "Screen or window" \
        --no-icons --lines 12 --minimal-lines --width 50 \
        --font "sans:size=12" \
        --background-color 1f1f21f0 --border-color ffffff1f \
        --border-width 1 --border-radius 12 \
        --text-color f2f2f2ff --prompt-color f2f2f2bf --placeholder-color f2f2f280 \
        --match-color f6c177ff --selection-color ffffff26 \
        --selection-text-color f2f2f2ff --selection-match-color f6c177ff \
        --selection-radius 8) || exit 0

# Anything but the number of a listed line declines.
[[ $index =~ ^[0-9]+$ ]] && ((index < ${#choices[@]})) || exit 0
printf '%s\n' "${choices[index]}"
